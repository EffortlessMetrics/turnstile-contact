{
  "name": "@effortlessmetrics/contact-core",
  "version": "0.1.8",
  "private": false,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EffortlessMetrics/turnstile-contact.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "npm run build && tsc -p tsconfig.json && node scripts/contact-tests.mjs && node scripts/memory-limit-tests.mjs",
    "test:packed": "node scripts/verify-packed.mjs",
    "prepack": "npm run build",
    "test:rollback": "node scripts/verify-rollback.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "5.9.3",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Framework-independent Turnstile contact endpoint and native browser form client",
  "keywords": [
    "turnstile",
    "contact-form",
    "cloudflare",
    "typescript"
  ],
  "homepage": "https://github.com/EffortlessMetrics/turnstile-contact#readme",
  "bugs": {
    "url": "https://github.com/EffortlessMetrics/turnstile-contact/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
